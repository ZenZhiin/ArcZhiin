# =============================================================================
# ArcZhiin — Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Providers
# -----------------------------------------------------------------------------

# Gemini API (Primary)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API (Optional)
OPENAI_API_KEY=your_openai_api_key_here

# Ollama (Local - no key needed)
OLLAMA_BASE_URL=http://localhost:11434

# -----------------------------------------------------------------------------
# LLM Routing Strategy
# -----------------------------------------------------------------------------

# Default model for simple/fast queries
LLM_MODEL_FAST=ollama/llama3.2:3b

# Default model for standard conversations
LLM_MODEL_DEFAULT=ollama/llama3.1:8b

# Model for complex reasoning tasks
LLM_MODEL_COMPLEX=gemini/gemini-2.5-flash

# Model for the most complex analysis
LLM_MODEL_PRO=gemini/gemini-2.5-pro

# -----------------------------------------------------------------------------
# Voice Pipeline
# -----------------------------------------------------------------------------

# Wake word sensitivity (0.0 - 1.0, higher = more sensitive)
WAKE_WORD_SENSITIVITY=0.5

# Wake word model name
WAKE_WORD_MODEL=hey_jarvis

# STT model size (tiny.en, base.en, small.en, medium.en)
STT_MODEL_SIZE=base.en

# TTS voice (piper voice name)
TTS_VOICE=en_US-lessac-medium

# -----------------------------------------------------------------------------
# Home Assistant
# -----------------------------------------------------------------------------

HOME_ASSISTANT_URL=http://localhost:8123
HOME_ASSISTANT_TOKEN=your_ha_long_lived_access_token_here

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

DATABASE_PATH=./data/arczhiin.db

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

HOST=0.0.0.0
PORT=8000
DEBUG=true
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------

# Secret key for session signing (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change_me_to_a_random_secret_key

# Allowed origins for CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
