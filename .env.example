# =============================================================================
# ArcZhiin — Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Providers
# -----------------------------------------------------------------------------

# Gemini API (Primary Cloud)
GEMINI_API_KEY=your_gemini_api_key_here

# Ollama (Local AI Hub - no key needed)
OLLAMA_BASE_URL=http://localhost:11434

# -----------------------------------------------------------------------------
# LLM Routing Strategy
# -----------------------------------------------------------------------------

# Default model for simple/fast queries (e.g. gemini-3.1-flash-lite or ollama/llama3.2:3b)
LLM_MODEL_FAST=gemini-3.1-flash-lite

# Default model for standard conversations (e.g. gemini-3-flash-preview or ollama/llama3.1:8b)
LLM_MODEL_DEFAULT=gemini-3-flash-preview

# Model for complex reasoning tasks
LLM_MODEL_COMPLEX=gemini-3-flash-preview

# Model for the most complex analysis
LLM_MODEL_PRO=gemini-3.1-pro-preview

# -----------------------------------------------------------------------------
# Voice Pipeline
# -----------------------------------------------------------------------------

# Wake word sensitivity (0.0 - 1.0, higher = more sensitive)
WAKE_WORD_SENSITIVITY=0.5

# Wake word model name
WAKE_WORD_MODEL=hey_jarvis

# STT model size (tiny.en, base.en, small.en, medium.en, large-v3)
STT_MODEL_SIZE=large-v3

# STT computation device (auto, cuda, cpu)
STT_DEVICE=auto

# TTS voice (piper voice name)
TTS_VOICE=en_US-lessac-medium

# -----------------------------------------------------------------------------
# Home Assistant
# -----------------------------------------------------------------------------

HOME_ASSISTANT_URL=http://localhost:8123
HOME_ASSISTANT_TOKEN=your_ha_long_lived_access_token_here

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

DATABASE_PATH=./data/arczhiin.db

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

HOST=0.0.0.0
PORT=8000
DEBUG=true
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Security & Network
# -----------------------------------------------------------------------------

# Secret key for session signing
SECRET_KEY=change_me_to_a_random_secret_key

# Allowed origins for CORS (* for LAN development)
CORS_ORIGINS=*
